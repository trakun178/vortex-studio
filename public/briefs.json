{
  "landing": {
    "title": "Бриф: Лендинг",
    "questions": [
      {
        "id": "name",
        "label": "Название продукта или компании",
        "type": "text",
        "required": true,
        "placeholder": "Например: барбершоп «Бритва»"
      },
      {
        "id": "essence",
        "label": "Что продаёте? Опишите бизнес в 2–3 предложениях",
        "type": "area",
        "required": true
      },
      {
        "id": "audience",
        "label": "Кто ваш клиент и его главная боль?",
        "type": "area",
        "required": true
      },
      {
        "id": "action",
        "label": "Главное действие на сайте",
        "type": "choice",
        "required": true,
        "options": [
          "Заявка на сайте",
          "Звонок",
          "Telegram / WhatsApp",
          "Онлайн-оплата"
        ]
      },
      {
        "id": "refs",
        "label": "3–5 примеров: конкуренты или просто классные сайты (ссылки)",
        "type": "area"
      },
      {
        "id": "style",
        "label": "Желаемый стиль",
        "type": "choice",
        "required": true,
        "options": [
          "Минимализм",
          "Премиум",
          "Агрессивный",
          "Дружелюбный",
          "Хай-тек",
          "Классика"
        ]
      },
      {
        "id": "colors",
        "label": "Фирменный цвет и «запрещённые» цвета",
        "type": "text",
        "placeholder": "Например: зелёный; без красного"
      },
      {
        "id": "benefits",
        "label": "3–5 главных выгод для клиента",
        "type": "area",
        "required": true
      },
      {
        "id": "assets",
        "label": "Какие материалы у вас есть?",
        "type": "multi",
        "options": ["Лого", "Фото", "Тексты", "Ничего — нужно создать"]
      },
      {
        "id": "budget",
        "label": "Вилка бюджета",
        "type": "choice",
        "options": [
          "15–25 тыс",
          "25–60 тыс",
          "60–150 тыс",
          "150+ тыс",
          "Не определился"
        ]
      },
      {
        "id": "annoy",
        "label": "Что бесит на сайтах конкурентов?",
        "type": "area"
      },
      {
        "id": "contact",
        "label": "Контакт для связи (телефон или TG)",
        "type": "text",
        "required": true
      }
    ],
    "prompt": "Дизайн лендинга для «{name}». Суть: {essence} ЦА и боль: {audience} Главное CTA: {action}. Стиль: {style}. Палитра: {colors}. Выгоды: {benefits}. Материалы: {assets}. Бюджет: {budget}. Референсы: {refs}. Избегать: {annoy}. Структура: hero (УТП + CTA), блок выгод, соцдоказательства, финальный CTA. Контакт: {contact}."
  },
